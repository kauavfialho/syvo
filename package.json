{
  "name": "syvo",
  "productName": "Syvo",
  "version": "2.8.0",
  "description": "Syvo - controle financeiro pessoal com banco local",
  "main": "electron/main.js",
  "author": "Kauã Fialho",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test testes/*.test.js",
    "dist:mac": "electron-builder --mac --publish never && node -e \"for(const d of ['dist/mac','dist/mac-arm64'])require('fs').rmSync(d,{recursive:true,force:true})\"",
    "dist:win": "electron-builder --win --publish never",
    "tauri:esquema": "node scripts/esquema-para-rust.js",
    "tauri:dev": "node scripts/esquema-para-rust.js && tauri dev",
    "tauri:build": "node scripts/esquema-para-rust.js && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.kauafialho.syvo",
    "productName": "Syvo",
    "artifactName": "Syvo-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Syvo-${os}-${arch}-portable.${ext}"
    }
  }
}
