{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syvo",
  "version": "2.6.2",
  "identifier": "com.kauafialho.syvo",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Syvo — Controle Financeiro",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance"
  }
}